<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Theminator</AssemblyName>
    <RootNamespace>Theminator</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>Assets\Oxminator.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Embed logo assets into the assembly so they work in single-file publish -->
  <ItemGroup>
    <Resource Include="Assets\Oxminator.ico"/>
    <Resource Include="Assets\Oxminator_256.png"/>
    <Resource Include="Assets\Oxminator_1024.png"/>
  </ItemGroup>

</Project>
